{
  "uid": "mibel-quality-obs",
  "title": "MIBEL — Qualidade & Observabilidade",
  "description": "Métricas de qualidade dos 3 Data Products: null rates, unicidade, completude, freshness e consistência de lags.",
  "tags": ["mibel", "quality", "observability"],
  "timezone": "Europe/Lisbon",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5m",
  "time": { "from": "now-90d", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [

    {
      "id": 1,
      "type": "text",
      "title": "",
      "gridPos": { "x": 0, "y": 0, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "## DP-01 — Produção vs Consumo (`dp_energia_balance_hourly`)\nChecks de schema, null rates, unicidade, freshness e consistência interna."
      }
    },

    {
      "id": 2,
      "type": "stat",
      "title": "DP-01 · Registos Gold",
      "description": "Total de horas horárias na tabela Gold de DP-01.",
      "gridPos": { "x": 0, "y": 2, "w": 4, "h": 4 },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none", "textMode": "value", "orientation": "auto" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 1000 }, { "color": "green", "value": 8000 }] },
          "mappings": []
        }
      },
      "targets": [{
        "rawSql": "SELECT COUNT(*) AS linhas FROM iceberg.gold.dp_energia_balance_hourly",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 3,
      "type": "stat",
      "title": "DP-01 · Freshness (dias)",
      "description": "Dias desde o último registo na Gold.",
      "gridPos": { "x": 4, "y": 2, "w": 4, "h": 4 },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none", "textMode": "value" },
      "fieldConfig": {
        "defaults": {
          "unit": "d",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 180 }, { "color": "red", "value": 400 }] }
        }
      },
      "targets": [{
        "rawSql": "SELECT date_diff('day', MAX(CAST(timestamp_utc AS DATE)), CURRENT_DATE) AS dias_atraso FROM iceberg.gold.dp_energia_balance_hourly",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 4,
      "type": "stat",
      "title": "DP-01 · Null Rate consumo_total_kwh (%)",
      "gridPos": { "x": 8, "y": 2, "w": 4, "h": 4 },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] }
        }
      },
      "targets": [{
        "rawSql": "SELECT ROUND(100.0 * SUM(CASE WHEN consumo_total_kwh IS NULL THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0), 2) AS null_pct FROM iceberg.gold.dp_energia_balance_hourly",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 5,
      "type": "stat",
      "title": "DP-01 · Horas c/ Fonte em Falta",
      "gridPos": { "x": 12, "y": 2, "w": 4, "h": 4 },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 24 }, { "color": "red", "value": 168 }] }
        }
      },
      "targets": [{
        "rawSql": "SELECT SUM(CASE WHEN flag_missing_source THEN 1 ELSE 0 END) AS horas_falta FROM iceberg.gold.dp_energia_balance_hourly",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 6,
      "type": "stat",
      "title": "DP-01 · Duplicados timestamp_utc",
      "gridPos": { "x": 16, "y": 2, "w": 4, "h": 4 },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }
        }
      },
      "targets": [{
        "rawSql": "SELECT SUM(CASE WHEN cnt > 1 THEN 1 ELSE 0 END) AS duplicados FROM (SELECT timestamp_utc, COUNT(*) AS cnt FROM iceberg.gold.dp_energia_balance_hourly GROUP BY timestamp_utc) AS g",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 7,
      "type": "stat",
      "title": "DP-01 · Silver — Duplicados 15min (consumo)",
      "gridPos": { "x": 20, "y": 2, "w": 4, "h": 4 },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 1 }] }
        }
      },
      "targets": [{
        "rawSql": "SELECT SUM(CASE WHEN cnt > 1 THEN 1 ELSE 0 END) AS duplicados FROM (SELECT timestamp_utc, COUNT(*) AS cnt FROM iceberg.silver.consumo_total_nacional_15min GROUP BY timestamp_utc) AS g",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 8,
      "type": "timeseries",
      "title": "DP-01 · Cobertura Horária por Mês (% horas com ambas as fontes)",
      "gridPos": { "x": 0, "y": 6, "w": 24, "h": 7 },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 80,
          "max": 100,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": 0 }, { "color": "yellow", "value": 90 }, { "color": "green", "value": 97 }] },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{
        "rawSql": "SELECT date_trunc('month', CAST(timestamp_utc AS DATE)) AS time, ROUND(100.0 * SUM(CASE WHEN consumo_total_kwh IS NOT NULL AND producao_total_kwh IS NOT NULL THEN 1 ELSE 0 END) / COUNT(*), 2) AS cobertura_pct FROM iceberg.gold.dp_energia_balance_hourly GROUP BY 1 ORDER BY 1",
        "format": "time_series",
        "refId": "A"
      }]
    },

    {
      "id": 9,
      "type": "text",
      "title": "",
      "gridPos": { "x": 0, "y": 13, "w": 24, "h": 2 },
      "options": {
        "mode": "markdown",
        "content": "## DP-02 — Consumo vs Preço MIBEL (`dp_energy_market_hourly`)\nChecks de null rates, unicidade, lag consistency e cobertura de features ML."
