          "rawSql": "SELECT\n  CASE\n    WHEN temperature_mean_c < 5  THEN '< 5°C'\n    WHEN temperature_mean_c < 10 THEN '5–10°C'\n    WHEN temperature_mean_c < 15 THEN '10–15°C'\n    WHEN temperature_mean_c < 20 THEN '15–20°C'\n    WHEN temperature_mean_c < 25 THEN '20–25°C'\n    ELSE '≥ 25°C'\n  END AS \"Temperatura\",\n  ROUND(AVG(producao_total_daily_mwh), 0) AS \"Produção Média (MWh)\",\n  COUNT(*) AS \"Dias\"\nFROM iceberg.gold.dp_meteo_producao_daily_features\nWHERE producao_total_daily_mwh IS NOT NULL\n  AND temperature_mean_c IS NOT NULL\nGROUP BY\n  CASE\n    WHEN temperature_mean_c < 5  THEN '< 5°C'\n    WHEN temperature_mean_c < 10 THEN '5–10°C'\n    WHEN temperature_mean_c < 15 THEN '10–15°C'\n    WHEN temperature_mean_c < 20 THEN '15–20°C'\n    WHEN temperature_mean_c < 25 THEN '20–25°C'\n    ELSE '≥ 25°C'\n  END\nORDER BY MIN(temperature_mean_c)",
          "format": 1,
          "refId": "A"
        }
      ]
