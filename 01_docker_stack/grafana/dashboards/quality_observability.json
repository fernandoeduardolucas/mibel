    {
      "id": 15,
      "type": "stat",
      "title": "DP-02 · Feat table — Null Target (%)",
      "description": "% de registos em feat_load_forecasting_hourly com consumo_next_hour NULL.",
      "gridPos": { "x": 20, "y": 15, "w": 4, "h": 4 },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "red", "value": 0.01 }] }
        }
      },
      "targets": [{
        "rawSql": "SELECT ROUND(100.0 * SUM(CASE WHEN consumo_next_hour IS NULL THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0), 4) AS null_pct FROM iceberg.gold.feat_load_forecasting_hourly",
        "format": "table",
        "refId": "A"
      }]
    },

    {
      "id": 16,
      "type": "timeseries",
      "title": "DP-02 · Lag Consistency — consumo_lag_1h vs hora anterior (% inconsistentes por mês)",
      "gridPos": { "x": 0, "y": 19, "w": 24, "h": 7 },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 5,
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.1 }] },
          "custom": { "lineWidth": 2, "fillOpacity": 10 }
        }
      },
      "options": { "tooltip": { "mode": "single" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [{
        "rawSql": "SELECT date_trunc('month', CAST(dp.ts_utc AS DATE)) AS time, ROUND(100.0 * SUM(CASE WHEN ABS(dp.consumo_lag_1h - prev.consumo_total) > 0.01 THEN 1 ELSE 0 END) / NULLIF(COUNT(*), 0), 4) AS pct_inconsistente FROM iceberg.gold.dp_energy_market_hourly AS dp JOIN iceberg.gold.dp_energy_market_hourly AS prev ON dp.ts_utc = date_add('hour', 1, prev.ts_utc) WHERE dp.consumo_lag_1h IS NOT NULL GROUP BY 1 ORDER BY 1",
        "format": "time_series",
        "refId": "A"
      }]
    },

    {
