{
  "__inputs": [
    {
      "name": "DS_TRINO",
      "label": "Trino",
      "description": "",
      "type": "datasource",
      "pluginId": "trino-datasource",
      "pluginName": "Trino"
    }
  ],
  "__requires": [
    { "type": "datasource", "id": "trino-datasource", "name": "Trino", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "DP-03 - Meteorologia vs Producao Eletrica vs Preco Spot MIBEL PT",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Temperatura Media",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "colorMode": "value", "graphMode": "area", "orientation": "auto" },
      "fieldConfig": {
        "defaults": { "unit": "celsius", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }, { "color": "orange", "value": 20 }, { "color": "red", "value": 30 }] } }
      },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "targets": [
        {
          "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
          "rawSql": "SELECT data_dia AS time, temperature_mean_c AS value FROM iceberg.gold.dp_meteo_producao_daily_features ORDER BY data_dia",
          "format": 0,
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Preco Spot Medio EUR/MWh",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "unit": "currencyEUR", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 60 }, { "color": "red", "value": 100 }] } }
      },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "targets": [
        {
          "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
          "rawSql": "SELECT data_dia AS time, preco_spot_medio_eur_mwh AS value FROM iceberg.gold.dp_meteo_producao_daily_features WHERE preco_spot_medio_eur_mwh IS NOT NULL ORDER BY data_dia",
          "format": 0,
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Producao Total Media MWh/dia",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": {
        "defaults": { "unit": "megwatt", "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue", "value": null }, { "color": "green", "value": 50000 }] } }
      },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "targets": [
        {
          "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
          "rawSql": "SELECT data_dia AS time, producao_total_daily_mwh AS value FROM iceberg.gold.dp_meteo_producao_daily_features WHERE producao_total_daily_mwh IS NOT NULL ORDER BY data_dia",
          "format": 0,
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Precipitacao Media mm/dia",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "lengthmm", "decimals": 1 } },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "targets": [
        {
          "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
          "rawSql": "SELECT data_dia AS time, precipitation_total_mm AS value FROM iceberg.gold.dp_meteo_producao_daily_features ORDER BY data_dia",
          "format": 0,
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Vento Medio m/s",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "velocityms", "decimals": 1 } },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "targets": [
        {
          "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
          "rawSql": "SELECT data_dia AS time, wind_speed_mean_ms AS value FROM iceberg.gold.dp_meteo_producao_daily_features ORDER BY data_dia",
          "format": 0,
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Radiacao Media W/m2",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "options": { "reduceOptions": { "calcs": ["mean"] }, "colorMode": "value", "graphMode": "area" },
      "fieldConfig": { "defaults": { "unit": "watt", "decimals": 0 } },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "targets": [
        {
          "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
          "rawSql": "SELECT data_dia AS time, radiation_mean_wm2 AS value FROM iceberg.gold.dp_meteo_producao_daily_features ORDER BY data_dia",
          "format": 0,
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Temperatura e Preco Spot ao Longo do Tempo",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 4 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "temperature_mean_c" }, "properties": [{ "id": "unit", "value": "celsius" }, { "id": "custom.axisPlacement", "value": "left" }] },
          { "matcher": { "id": "byName", "options": "preco_spot_medio_eur_mwh" }, "properties": [{ "id": "unit", "value": "currencyEUR" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "targets": [
        {
          "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
          "rawSql": "SELECT data_dia AS time, temperature_mean_c, preco_spot_medio_eur_mwh FROM iceberg.gold.dp_meteo_producao_daily_features WHERE preco_spot_medio_eur_mwh IS NOT NULL ORDER BY data_dia",
          "format": 0,
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Vento e Producao Eletrica ao Longo do Tempo",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 4 },
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 2, "fillOpacity": 10 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "wind_speed_mean_ms" }, "properties": [{ "id": "unit", "value": "velocityms" }, { "id": "custom.axisPlacement", "value": "left" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] },
          { "matcher": { "id": "byName", "options": "producao_total_daily_mwh" }, "properties": [{ "id": "unit", "value": "megwatt" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] }
        ]
      },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "targets": [
        {
          "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
          "rawSql": "SELECT data_dia AS time, wind_speed_mean_ms, producao_total_daily_mwh FROM iceberg.gold.dp_meteo_producao_daily_features WHERE producao_total_daily_mwh IS NOT NULL ORDER BY data_dia",
          "format": 0,
          "refId": "A"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "Radiacao Solar e Preco Spot",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 13 },
      "options": { "tooltip": { "mode": "multi" }, "legend": { "displayMode": "list", "placement": "bottom" } },
      "fieldConfig": {
        "defaults": { "custom": { "lineWidth": 1.5, "fillOpacity": 8 } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "radiation_mean_wm2" }, "properties": [{ "id": "unit", "value": "watt" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "preco_spot_medio_eur_mwh" }, "properties": [{ "id": "unit", "value": "currencyEUR" }, { "id": "custom.axisPlacement", "value": "right" }, { "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] }
        ]
      },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "targets": [
        {
          "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
          "rawSql": "SELECT data_dia AS time, radiation_mean_wm2, preco_spot_medio_eur_mwh FROM iceberg.gold.dp_meteo_producao_daily_features WHERE preco_spot_medio_eur_mwh IS NOT NULL ORDER BY data_dia",
          "format": 0,
          "refId": "A"
        }
      ]
    },
    {
      "id": 21,
      "type": "table",
      "title": "Tabela DP-03 - Ultimos 30 Dias com Dados Completos",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 13 },
      "options": { "showHeader": true },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "targets": [
        {
          "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
          "rawSql": "SELECT CAST(data_dia AS VARCHAR) AS Dia, ROUND(temperature_mean_c,1) AS \"Temp C\", ROUND(precipitation_total_mm,1) AS \"Precip mm\", ROUND(wind_speed_mean_ms,1) AS \"Vento ms\", ROUND(radiation_mean_wm2,0) AS \"Rad Wm2\", ROUND(producao_total_daily_mwh,0) AS \"Producao MWh\", ROUND(preco_spot_medio_eur_mwh,2) AS \"Preco EUR\" FROM iceberg.gold.dp_meteo_producao_daily_features WHERE preco_spot_medio_eur_mwh IS NOT NULL AND producao_total_daily_mwh IS NOT NULL ORDER BY data_dia DESC LIMIT 30",
          "format": 1,
          "refId": "A"
        }
      ]
    },
    {
      "id": 30,
      "type": "barchart",
      "title": "Preco Medio por Estacao do Ano",
      "description": "1=Inverno, 2=Primavera, 3=Verao, 4=Outono",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 21 },
      "options": {
        "orientation": "auto",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": { "unit": "currencyEUR", "color": { "mode": "palette-classic" } }
      },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "targets": [
        {
          "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
          "rawSql": "SELECT CAST(estacao AS VARCHAR) AS estacao, ROUND(AVG(preco_spot_medio_eur_mwh),2) AS preco_medio FROM iceberg.gold.dp_meteo_producao_daily_features WHERE preco_spot_medio_eur_mwh IS NOT NULL GROUP BY estacao ORDER BY estacao",
          "format": 1,
          "refId": "A"
        }
      ]
    },
    {
      "id": 31,
      "type": "barchart",
      "title": "Producao Media por Estacao do Ano",
      "description": "1=Inverno, 2=Primavera, 3=Verao, 4=Outono",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 21 },
      "options": {
        "orientation": "auto",
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "fieldConfig": {
        "defaults": { "unit": "megwatt", "color": { "mode": "palette-classic" } }
      },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "targets": [
        {
          "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
          "rawSql": "SELECT CAST(estacao AS VARCHAR) AS estacao, ROUND(AVG(producao_total_daily_mwh),0) AS producao_media FROM iceberg.gold.dp_meteo_producao_daily_features WHERE producao_total_daily_mwh IS NOT NULL GROUP BY estacao ORDER BY estacao",
          "format": 1,
          "refId": "A"
        }
      ]
    }
  ],
  "refresh": "1h",
  "schemaVersion": 38,
  "tags": ["energia", "meteorologia", "mibel", "dp-03"],
  "templating": { "list": [] },
  "time": { "from": "2023-01-01", "to": "2026-03-04" },
  "timepicker": {},
