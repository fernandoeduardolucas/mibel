    },

    {
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "description": "Índice = preço normalizado − consumo normalizado. Valores positivos: hora com preço relativamente alto e consumo relativamente baixo — janela ideal para vender energia renovável.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": -10 },
              { "color": "#73BF69", "value": 5 }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": { "h": 10, "w": 10, "x": 14, "y": 6 },
      "id": 21,
      "options": {
        "barAlignment": 0,
        "fillOpacity": 75,
        "groupWidth": 0.7,
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" },
        "xField": "Hora"
      },
      "targets": [
        {
          "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
          "format": 1,
          "rawSql": "WITH hourly AS (\n  SELECT\n    hora,\n    AVG(market_price_pt) AS avg_price,\n    AVG(consumo_total) AS avg_consumo\n  FROM iceberg.gold.dp_energy_market_api_hourly\n  WHERE $__timeFilter(ts_utc)\n    AND market_price_pt IS NOT NULL\n    AND consumo_total IS NOT NULL\n  GROUP BY hora\n),\nmaxes AS (\n  SELECT MAX(avg_price) AS max_price, MAX(avg_consumo) AS max_consumo\n  FROM hourly\n)\nSELECT\n  LPAD(CAST(h.hora AS VARCHAR), 2, '0') || 'h' AS \"Hora\",\n  ROUND(\n    (h.avg_price / m.max_price - h.avg_consumo / m.max_consumo) * 100,\n    1\n  ) AS \"Índice de Oportunidade (%)\"\nFROM hourly h, maxes m\nORDER BY h.hora",
          "refId": "A"
        }
      ],
      "title": "Índice de Oportunidade por Hora (Preço Alto / Consumo Baixo → Verde)",
      "type": "barchart"
    },

