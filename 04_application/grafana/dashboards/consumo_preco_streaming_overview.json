      },
      "targets": [
        {
          "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
          "format": 1,
          "rawSql": "SELECT\n  LPAD(CAST(hora AS VARCHAR), 2, '0') || 'h' AS \"Hora\",\n  ROUND(AVG(market_price_pt), 2) AS \"Preço Médio PT (€/MWh)\"\nFROM iceberg.gold.dp_energy_market_api_hourly\nWHERE $__timeFilter(ts_utc)\n  AND market_price_pt IS NOT NULL\nGROUP BY hora\nORDER BY hora",
