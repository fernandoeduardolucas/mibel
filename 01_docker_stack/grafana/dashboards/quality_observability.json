      "options": {
        "mode": "markdown",
        "content": "## Resumo de Qualidade — Comparação entre Data Products\nNull rates e completude comparados lado a lado para os 3 DPs."
      }
    },

    {
      "id": 26,
      "type": "table",
      "title": "Resumo de Qualidade — Null Rates e Completude por DP",
      "gridPos": { "x": 0, "y": 42, "w": 24, "h": 10 },
      "datasource": { "type": "trino-datasource", "uid": "trino-iceberg" },
      "options": { "sortBy": [{ "displayName": "dp", "desc": false }] },
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "null_rate_pct" }, "properties": [{ "id": "unit", "value": "percent" }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 5 }] } }, { "id": "custom.displayMode", "value": "color-background" }] },
          { "matcher": { "id": "byName", "options": "freshness_dias" }, "properties": [{ "id": "unit", "value": "d" }, { "id": "thresholds", "value": { "mode": "absolute", "steps": [{ "color": "green", "value": 0 }, { "color": "yellow", "value": 180 }, { "color": "red", "value": 400 }] } }, { "id": "custom.displayMode", "value": "color-background" }] }
